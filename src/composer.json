{
  "name": "attlaz/core",
  "description": "Attlaz Core: core Attlaz application",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^7.1.2",
    "php-amqplib/php-amqplib": "^2.6",
    "monolog/monolog": "^1.23",
    "bramus/monolog-colored-line-formatter": "~2.0",
    "symfony/yaml": "^3.3",
    "symfony/serializer": "^3.3",
    "guzzlehttp/guzzle": "^6.3",
    "echron/tools": "dev-develop",
    "echron/datatypes": "dev-develop",
    "php-di/php-di": "6.0.0-alpha4",
    "ruflin/elastica": "5.3.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^6.3"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\": "Attlaz"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Core\\": "tests"
    }
  },
  "scripts": {
    "start-worker": "php run.php worker:start",
    "start-manager": "php run.php manager:start test",
    "test": "vendor/bin/phpunit"
  }
}
