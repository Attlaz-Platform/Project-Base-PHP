#!/usr/bin/env php
<?php
declare(strict_types=1);

$projectRoot = dirname(__DIR__);
require __DIR__ . '/launcher.php';

/*
 * Composer launcher. Always runs composer inside the attlaz/php image matching this project's
 * required PHP, so platform requirements resolve against the target runtime. The host needs only
 * Docker (and any PHP to run this launcher) -- not composer or the right PHP version.
 */
$version = attlaz_required_php($projectRoot);
if ($version === null) {
    fwrite(STDERR, 'Unable to detect the PHP version from composer.json "require.php".' . PHP_EOL);
    exit(1);
}

exit(attlaz_run_in_docker($projectRoot, attlaz_php_image($version), 'composer', array_slice($argv, 1)));
