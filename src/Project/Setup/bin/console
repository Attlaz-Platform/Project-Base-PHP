#!/usr/bin/env php
<?php
declare(strict_types=1);

$projectRoot = dirname(__DIR__);
require __DIR__ . '/launcher.php';

/*
 * Developer entry point. If the host PHP is older than this project requires, re-run the command
 * inside the matching attlaz/php Docker image; otherwise boot the app directly. The Attlaz worker
 * and the in-container run use bin/console.php, which skips these checks and never touches Docker.
 *
 * Keep this file parseable on old host PHP (no 8.4-only syntax) so the routing runs before any
 * newer-PHP code is loaded.
 */
$version = attlaz_required_php($projectRoot);
if ($version !== null && PHP_VERSION_ID < $version[0] * 10000 + $version[1] * 100) {
    exit(attlaz_run_in_docker($projectRoot, attlaz_php_image($version), 'php bin/console.php', array_slice($argv, 1)));
}

require $projectRoot . '/vendor/autoload.php';
(new \Attlaz\Project\Project($projectRoot))->run();
