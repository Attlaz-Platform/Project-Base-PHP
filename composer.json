{
  "name": "attlaz/project-base",
  "description": "Basic set to start a Attlaz project",
  "license": "MIT",
  "type": "project",
  "homepage": "https://attlaz.com",
  "require": {
    "php": ">=8.2",
    "echron/tools": "^1.7.0",
    "echron/datatypes": "^2.0.0|^1.6.0|dev-develop",
    "php-di/php-di": "^7.0.7",
    "psr/simple-cache": "^1 || ^2 || ^3",
    "attlaz/client": "^1.15.0",
    "attlaz/attlaz-monolog": "^2.1.2",
    "attlaz/adapter-base": "^1.15.1|dev-develop",
    "vlucas/phpdotenv": "^5.6.1",
    "symfony/console": "^v7.2.0",
    "symfony/yaml": "^v7.2.0",
    "thecodingmachine/safe": "^v3.0.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.0",
    "bramus/monolog-colored-line-formatter": "^3.1",
    "phpstan/phpstan": "^2.0.3",
    "friendsofphp/php-cs-fixer": "^v3.65.0"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\": "tests",
      "App\\": ".project/src/App"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.attlaz.com"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit",
    "lint:fix": " ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "phpstan": " ./vendor/bin/phpstan analyse --memory-limit=512M",
    "phpstan:generate-baseline": " ./vendor/bin/phpstan analyse --generate-baseline --memory-limit=512M"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "phpro/grumphp": true
    }
  }
}
