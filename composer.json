{
  "name": "attlaz/project-base",
  "description": "Basic set to start a Attlaz project",
  "license": "MIT",
  "type": "project",
  "homepage": "https://attlaz.com",
  "require": {
    "php": ">=7.2 | >=8.0",
    "monolog/monolog": "^2.0",
    "echron/tools": "^1.3.1",
    "echron/datatypes": "^1.3.0",
    "php-di/php-di": "^6.3.0",
    "ramsey/uuid": "3.7.*",
    "attlaz/client": "1.5.*",
    "attlaz/attlaz-monolog": "^1.0",
    "doctrine/annotations": "^1.13.2",
    "vlucas/phpdotenv": "2.5.*",
    "symfony/console": "^4.4.0",
    "symfony/yaml": "~3.0|^4.0",
    "ext-json": "*",
    "psr/simple-cache": "^1.0",
    "psr/cache": "^1.0",
    "cache/adapter-common": "^1.2",
    "cache/simple-cache-bridge": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0.0",
    "bramus/monolog-colored-line-formatter": "^3.0",
    "phpstan/phpstan": "^0.12",
    "squizlabs/php_codesniffer": "^3.3",
    "jakub-onderka/php-parallel-lint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\Project\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Project\\": "tests",
      "App\\": ".project/src/App"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.echron.be/"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "phpro/grumphp": true
    }
  }
}
