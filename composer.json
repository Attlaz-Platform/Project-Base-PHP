{
  "name": "attlaz/project-base",
  "description": "Basic set to start a Attlaz project",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^7.2.0",
    "monolog/monolog": "^2.0",
    "echron/tools": "^1.3.1",
    "echron/datatypes": "^1.0.0",
    "php-di/php-di": "^6.0.11",
    "psr/cache": "^1.0",
    "ramsey/uuid": "3.7.*",
    "mongodb/mongodb": "1.2.*",
    "attlaz/client": "^1.4.3",
    "attlaz/attlaz-monolog": "^1.0",
    "cache/filesystem-adapter": "^1.0.0",
    "cache/array-adapter": "^1.0.1",
    "cache/mongodb-adapter": "^1.1.0",
    "doctrine/annotations": "1.6.*",
    "vlucas/phpdotenv": "2.5.*",
    "symfony/console": "^4.1.7",
    "symfony/yaml": "~3.0|^4.0",
    "ext-mongodb": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0.0",
    "bramus/monolog-colored-line-formatter": "^3.0",
    "phpro/grumphp": "^0.16",
    "phpstan/phpstan": "^0.12",
    "squizlabs/php_codesniffer": "^3.3",
    "jakub-onderka/php-parallel-lint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\Project\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Project\\": "tests",
      "App\\": ".project/src/App"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.echron.be/"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
