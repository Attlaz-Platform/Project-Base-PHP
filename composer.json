{
  "name": "attlaz/project-base",
  "description": "Basic set to start a Attlaz project",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^7.2.0",
    "monolog/monolog": "^1.24.0",
    "symfony/console": "^4.1.7",
    "echron/tools": "^1.0.8",
    "echron/datatypes": "^1.0.0",
    "echron/io": "^1.0.0",
    "php-di/php-di": "^6.0.5",
    "psr/cache": "^1.0",
    "cache/filesystem-adapter": "^1.0",
    "phpseclib/phpseclib": "2.0.*",
    "cache/array-adapter": "^1.0@dev",
    "ramsey/uuid": "3.7.*",
    "mongodb/mongodb": "1.2.*",
    "attlaz/client": "^1.3.0",
    "cache/mongodb-adapter": "1.0.*",
    "cache/chain-adapter": "1.0.*",
    "doctrine/annotations": "1.6.*",
    "vlucas/phpdotenv": "2.5.*",
    "ext-mongodb": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^6.3",
    "bramus/monolog-colored-line-formatter": "~2.0",
    "phpro/grumphp": "^0.14.2",
    "phpstan/phpstan": "^0.10.5",
    "squizlabs/php_codesniffer": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\Project\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Project\\": "tests"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.echron.be/"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
