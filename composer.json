{
  "name": "attlaz/project-base",
  "description": "Basic set to start a Attlaz project",
  "license": "MIT",
  "type": "project",
  "homepage": "https://attlaz.com",
  "require": {
    "php": ">=8.1",
    "monolog/monolog": "^3.0",
    "echron/tools": "^1.6.0",
    "echron/datatypes": "^1.4.0",
    "php-di/php-di": "^7.0.1",
    "psr/simple-cache": "^1 || ^2 || ^3",
    "attlaz/client": "^1.9.4",
    "attlaz/attlaz-monolog": "^1.1.5|^2.0",
    "attlaz/adapter-base": "^1.4.0 | dev-develop",
    "vlucas/phpdotenv": "^5.5.0",
    "symfony/console": "^6.2",
    "symfony/yaml": "^6.2",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5.13",
    "bramus/monolog-colored-line-formatter": "^3.0",
    "phpstan/phpstan": "^1.9",
    "squizlabs/php_codesniffer": "^3.6.2",
    "php-parallel-lint/php-parallel-lint": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\Project\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Project\\": "tests",
      "App\\": ".project/src/App"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.echron.be/"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "phpro/grumphp": true
    }
  }
}
