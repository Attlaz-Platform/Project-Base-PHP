{
  "name": "attlaz/core",
  "description": "Attlaz Core: core Attlaz application",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^7.1.2",
    "php-amqplib/rabbitmq-bundle": "^1.13",
    "symfony/console": "^3.3",
    "symfony/dependency-injection": "^3.3",
    "php-amqplib/php-amqplib": "^2.6",
    "monolog/monolog": "^1.23",
    "symfony/yaml": "^3.3",
    "symfony/serializer": "^3.3",
    "react/promise": "^2.5",
    "react/event-loop": "^0.4.3",
    "guzzlehttp/guzzle": "^6.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^6.3"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\Core\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Core\\": "tests"
    }
  },
  "scripts": {
    "start-worker": "php run.php worker:start",
    "start-manager": "php run.php manager:start test",
    "test": "vendor/bin/phpunit"
  }
}
