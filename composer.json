{
  "name": "attlaz/project",
  "description": "Basic set to start a Attlaz project",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^7.2.0",
    "monolog/monolog": "^1.23",
    "bramus/monolog-colored-line-formatter": "~2.0",
    "symfony/yaml": "^3.3",
    "symfony/serializer": "^3.3",
    "guzzlehttp/guzzle": "^6.3",
    "echron/tools": "1.0.*",
    "echron/datatypes": "dev-develop",
    "echron/io": "dev-develop",
    "php-di/php-di": "^6.0.0",
    "psr/cache": "^1.0",
    "cache/filesystem-adapter": "^1.0",
    "phpseclib/phpseclib": "2.0.*",
    "cache/array-adapter": "^1.0@dev",
    "ramsey/uuid": "3.7.*",
    "mongodb/mongodb": "1.2.*",
    "attlaz/client": "dev-develop",
    "cache/mongodb-adapter": "1.0.*",
    "cache/chain-adapter": "1.0.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^6.3"
  },
  "autoload": {
    "psr-4": {
      "Attlaz\\Project\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Attlaz\\Project\\": "tests"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.echron.be/"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
